  create or replace view `dbt-pruebas-488515`.`dbt_test`.`answer_stats`
  OPTIONS(
      description="""Job: calculates upvote and downvote counts for each answer"""
    )
  as 

select
    id,
    owner_user_id,

    (
        select count(*)

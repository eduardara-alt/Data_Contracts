  create or replace view `dbt-pruebas-488515`.`dbt_test`.`User Stats`
  OPTIONS(
      description="""Dataset: aggregates statistics per user (questions, answers, votes)"""
    )
  as 

select
    fu.id,
    fu.display_name,
    fu.creation_date,
    fu.last_access_date,
    fu.profile_image_url,

    -- Preguntas
    (
        select count(*) 
        from `dbt-pruebas-488515`.`dbt_test`.`Question Stats` qs
        where qs.owner_user_id = fu.id
    ) as questions_posted,
    (
        select sum(qs.upvote_count) 
        from `dbt-pruebas-488515`.`dbt_test`.`Question Stats` qs
        where qs.owner_user_id = fu.id
    ) as questions_posted_upvotes,
    (
        select sum(qs.downvote_count) 
        from `dbt-pruebas-488515`.`dbt_test`.`Question Stats` qs
        where qs.owner_user_id = fu.id
    ) as questions_posted_downvotes,
    (
        select sum(qs.answer_count) 
        from `dbt-pruebas-488515`.`dbt_test`.`Question Stats` qs
        where qs.owner_user_id = fu.id
    ) as answers_inspired,

    -- Respuestas
    (
        select count(*) 
        from `dbt-pruebas-488515`.`dbt_test`.`Answer Stats` ans
        where ans.owner_user_id = fu.id
    ) as answers_posted,
    (
        select sum(ans.upvote_count) 
        from `dbt-pruebas-488515`.`dbt_test`.`Answer Stats` ans
        where ans.owner_user_id = fu.id
    ) as answers_posted_upvotes,
    (
        select sum(ans.downvote_count) 
        from `dbt-pruebas-488515`.`dbt_test`.`Answer Stats` ans
        where ans.owner_user_id = fu.id
    ) as answers_posted_downvotes

from `dbt-pruebas-488515`.`dbt_test`.`Filtered Users` fu;



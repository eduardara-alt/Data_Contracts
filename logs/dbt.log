  create or replace view `dbt-pruebas-488515`.`dbt_test`.`answer_stats`
  OPTIONS(
      description="""Job: calculates upvote and downvote counts for each answer"""
    )
  as 

select
    id,
    owner_user_id,

    (
        select count(*)
        from `dbt-pruebas-488515`.`dbt_test`.`filtered_votes`
        where post_id = filtered_answers.id
        and vote_type_id = 2
    ) as upvote_count,

    (
        select count(*)
        from `dbt-pruebas-488515`.`dbt_test`.`filtered_votes`
        where post_id = filtered_answers.id

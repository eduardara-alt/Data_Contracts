    (
        select sum(answer_count) from `sdg-team-bankin-dataplex-demo`.`Artefacto_Linaje`.`question_stats`
        where owner_user_id = filtered_users.id
    ) as answers_inspired,
    (
        select count(*) from `sdg-team-bankin-dataplex-demo`.`Artefacto_Linaje`.`answer_stats`
        where owner_user_id = filtered_users.id
    ) as answers_posted,
    (
        select sum(upvote_count) from `sdg-team-bankin-dataplex-demo`.`Artefacto_Linaje`.`answer_stats`
        where owner_user_id = filtered_users.id
    ) as answers_posted_upvotes,
    (
        select sum(downvote_count) from `sdg-team-bankin-dataplex-demo`.`Artefacto_Linaje`.`answer_stats`
        where owner_user_id = filtered_users.id
    ) as answers_posted_downvotes
from `sdg-team-bankin-dataplex-demo`.`Artefacto_Linaje`.`filtered_users`;



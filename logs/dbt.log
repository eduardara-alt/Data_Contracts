  create or replace view `sdg-team-bankin-dataplex-demo`.`Artefacto_Linaje`.`users_transformed2`
  OPTIONS(
      description="""Enriquece usuarios con antig\u00fcedad de cuenta y total de votos calculados"""
    )
  as 

SELECT
    id,
    display_name,
    reputation,
    age,
    location,
    account_age_days,
    CASE
        WHEN reputation > 1000 THEN 'high'
        WHEN reputation > 100 THEN 'medium'
        ELSE 'low'
    END AS reputation_level,
    total_votes,
    views,
    total_votes / NULLIF(account_age_days, 0) AS votes_per_day
FROM `sdg-team-bankin-dataplex-demo`.`Artefacto_Linaje`.`users_transformed`;



  create or replace view `dbt-pruebas-488515`.`dbt_test`.`User Stats`
  OPTIONS(
      description="""Dataset: aggregates statistics per user (questions, answers, votes)"""
    )
  as 

select
    id,
    display_name,
    creation_date,
    last_access_date,
    profile_image_url,
    (
        select count(*) from `dbt-pruebas-488515`.`dbt_test`.`Question Stats`
        where owner_user_id = filtered_users.id
    ) as questions_posted,
    (
        select sum(upvote_count) from `dbt-pruebas-488515`.`dbt_test`.`Question Stats`
        where owner_user_id = filtered_users.id
    ) as questions_posted_upvotes,
    (
        select sum(downvote_count) from `dbt-pruebas-488515`.`dbt_test`.`Question Stats`
        where owner_user_id = filtered_users.id
    ) as questions_posted_downvotes,
    (
        select sum(answer_count) from `dbt-pruebas-488515`.`dbt_test`.`Question Stats`
        where owner_user_id = filtered_users.id
    ) as answers_inspired,
    (
        select count(*) from `dbt-pruebas-488515`.`dbt_test`.`Answer Stats`
        where owner_user_id = filtered_users.id
    ) as answers_posted,
    (
        select sum(upvote_count) from `dbt-pruebas-488515`.`dbt_test`.`Answer Stats`
        where owner_user_id = filtered_users.id
    ) as answers_posted_upvotes,
    (
        select sum(downvote_count) from `dbt-pruebas-488515`.`dbt_test`.`Answer Stats`
        where owner_user_id = filtered_users.id
    ) as answers_posted_downvotes
from `dbt-pruebas-488515`.`dbt_test`.`Filtered Users`;



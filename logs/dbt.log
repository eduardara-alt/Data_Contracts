  create or replace view `sdg-team-bankin-dataplex-demo`.`Artefacto_Linaje`.`user_stats`
  OPTIONS(
      description="""Dataset: aggregates statistics per user (questions, answers, votes)"""
    )
  as 

select
    id,
    display_name,
    creation_date,
    last_access_date,
    profile_image_url,
    (
        select count(*) from `sdg-team-bankin-dataplex-demo`.`Artefacto_Linaje`.`question_stats`
        where owner_user_id = filtered_users.id
    ) as questions_posted,
    (
        select sum(upvote_count) from `sdg-team-bankin-dataplex-demo`.`Artefacto_Linaje`.`question_stats`
        where owner_user_id = filtered_users.id
    ) as questions_posted_upvotes,
    (
        select sum(downvote_count) from `sdg-team-bankin-dataplex-demo`.`Artefacto_Linaje`.`question_stats`
        where owner_user_id = filtered_users.id
    ) as questions_posted_downvotes,
    (
        select sum(answer_count) from `sdg-team-bankin-dataplex-demo`.`Artefacto_Linaje`.`question_stats`
        where owner_user_id = filtered_users.id
    ) as answers_inspired,
    (
        select count(*) from `sdg-team-bankin-dataplex-demo`.`Artefacto_Linaje`.`answer_stats`
        where owner_user_id = filtered_users.id
    ) as answers_posted,
    (
        select sum(upvote_count) from `sdg-team-bankin-dataplex-demo`.`Artefacto_Linaje`.`answer_stats`
        where owner_user_id = filtered_users.id
    ) as answers_posted_upvotes,
    (
        select sum(downvote_count) from `sdg-team-bankin-dataplex-demo`.`Artefacto_Linaje`.`answer_stats`
        where owner_user_id = filtered_users.id
    ) as answers_posted_downvotes
from `sdg-team-bankin-dataplex-demo`.`Artefacto_Linaje`.`filtered_users`;


